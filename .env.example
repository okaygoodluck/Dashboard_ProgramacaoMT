# ==============================================================================
# CONFIGURAÇÕES DE REDE DO SISTEMA (VARIÁVEIS DE AMBIENTE)
# ==============================================================================
# Para utilizar caminhos UNC universais (recomendado), substitua o 'I:\...'
# pelo caminho de rede real, ex: \\servidor\pasta\IT\ODCO\...
# O Python lerá estas variáveis em vez de depender da letra da unidade.

# Caminho para os bancos de dados do Dashboard MT
CCP_DASHBOARD_DB_PATH="I:\IT\ODCO\PROGRAMACAO_MT\1 - Sistemas da programação\Dashboard MT"

# Caminho para as planilhas do Mesão Diário
CCP_MESAO_DIARIO_PATH="I:\IT\ODCO\PROGRAMACAO_MT\Mesao_Diario"

# Credenciais GDIS (configure via scripts/configurar_credenciais.py)
# GDIS_USUARIO=seu_usuario
# GDIS_SENHA=sua_senha

# Agendador (opcionais)
# AGENDADOR_JANELA_INICIO=07:00
# AGENDADOR_JANELA_FIM=20:00
# AGENDADOR_PAUSA_SEGUNDOS=60
