# ==============================================================================
# CONFIGURAÇÕES DE REDE DO SISTEMA (VARIÁVEIS DE AMBIENTE)
# ==============================================================================
# Caminho UNC corporativo universal oficial (recomendado - dispensa letra de unidade):
CCP_DASHBOARD_DB_PATH="\\SACORPARQ1\GROUPS\IT\ODCO\PROGRAMACAO_MT\1 - Sistemas da programação\Dashboard MT"

# Caminho para as planilhas do Mesão Diário
CCP_MESAO_DIARIO_PATH="\\SACORPARQ1\GROUPS\IT\ODCO\PROGRAMACAO_MT\Mesao_Diario"

# Modo Servidor: 'true' para a máquina servidora local dedicada (prioriza leitura/escrita no SSD local)
# Para máquinas clientes ou Home Office portátil, deixe como 'false' ou comente a linha.
# CCP_SERVER_MODE=true

# Credenciais GDIS (configure via scripts/configurar_credenciais.py)
# GDIS_USUARIO=seu_usuario
# GDIS_SENHA=sua_senha

# Agendador (opcionais)
# AGENDADOR_JANELA_INICIO=07:00
# AGENDADOR_JANELA_FIM=20:00
# AGENDADOR_PAUSA_SEGUNDOS=60
